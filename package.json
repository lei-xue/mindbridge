{
  "name": "mindbridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "social:images": "node scripts/build-social-images.mjs",
    "lint": "oxlint",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:ui": "playwright test --config=playwright.config.mjs",
    "test:safety": "playwright test --config=playwright.production.config.mjs",
    "worker:dev": "wrangler dev --config workers/la-county-directory/wrangler.jsonc --var ALLOWED_ORIGINS:http://localhost:5173,http://127.0.0.1:5173",
    "worker:deploy": "wrangler deploy --config workers/la-county-directory/wrangler.jsonc",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.141.0"
  }
}
