{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mindbridge-la-county-directory",
  "main": "index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "routes": [
    { "pattern": "mindbridge.leixue.dev/api/la-county/locations", "zone_name": "leixue.dev" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://mindbridge.leixue.dev"
  },
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  }
}
